{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["Es2022","DOM"],
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"],
        "baseUrl": ".",
        "outDir": "./dist",       /* <--- MAKE SURE THIS IS UNCOMMENTED AND SET TO ./dist */
        "rootDir": "./src",        /* <--- Ensure this points to your source folder */
        "ignoreDeprecations": "6.0",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}